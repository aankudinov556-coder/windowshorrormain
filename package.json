{
  "name": "after-sign-off",
  "productName": "After Sign-Off",
  "version": "0.1.0",
  "description": "An analog horror game disguised as an old operating system.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "serve": "python3 -m http.server 8080 --directory src",
    "photos": "python3 tools/gen_photos.py",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.aftersignoff.game",
    "productName": "After Sign-Off",
    "executableName": "Meridian",
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Meridian"
    },
    "portable": {
      "artifactName": "Meridian-portable.exe"
    }
  }
}
