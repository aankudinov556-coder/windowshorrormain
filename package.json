{
  "name": "after-sign-off",
  "productName": "After Sign-Off",
  "version": "0.1.0",
  "description": "An analog horror game disguised as an old operating system.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "serve": "python3 -m http.server 8080 --directory src",
    "photos": "python3 tools/gen_photos.py",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.aftersignoff.game",
    "productName": "After Sign-Off",
    "executableName": "Meridian",
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Meridian",
      "artifactName": "AfterSignOff-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "AfterSignOff-${version}-portable.${ext}"
    },
    "artifactName": "AfterSignOff-${version}-win-${arch}.${ext}"
  },
  "author": "After Sign-Off"
}
